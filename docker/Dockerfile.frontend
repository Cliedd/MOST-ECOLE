# ---- Build stage ----
FROM node:20-alpine AS builder
WORKDIR /app

COPY frontend/package*.json ./
RUN npm install --quiet

COPY frontend/ ./
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# ---- Runtime stage ----
FROM nginx:1.27-alpine
WORKDIR /usr/share/nginx/html

COPY --from=builder /app/dist .
# Store template — PORT will be substituted at container startup
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf.template

EXPOSE 80

# envsubst replaces ${PORT} in the template with the actual Railway PORT value
CMD ["/bin/sh", "-c", \
  "envsubst '${PORT}' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
